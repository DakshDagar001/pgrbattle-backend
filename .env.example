# ==================================================
# SERVER CONFIGURATION
# ==================================================
PORT=8080
NODE_ENV=production

# ==================================================
# FIREBASE CREDENTIALS
# ==================================================
# Project ID from Firebase Console
FIREBASE_PROJECT_ID=pgr-battle

# Private Key ID from Service Account JSON
FIREBASE_PRIVATE_KEY_ID=

# Private Key from Service Account JSON (preserve \n or actual newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Client Email from Service Account JSON
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@pgr-battle.iam.gserviceaccount.com

# Client ID from Service Account JSON
FIREBASE_CLIENT_ID=

# Database URL from Firebase Console
FIREBASE_DATABASE_URL=https://pgr-battle-default-rtdb.firebaseio.com

# ==================================================
# GMAIL CONFIGURATION (Legacy — no longer required for deposits)
# ==================================================
# OAuth2 Client ID from Google Cloud Console
GMAIL_CLIENT_ID=

# OAuth2 Client Secret from Google Cloud Console
GMAIL_CLIENT_SECRET=

# OAuth2 Redirect URI (e.g., https://developers.google.com/oauthplayground)
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# OAuth2 Refresh Token (generated via OAuth playground or script)
GMAIL_REFRESH_TOKEN=

# ==================================================
# ZAPUPI CONFIGURATION (Required for automatic deposits)
# ==================================================
# API Key from ZapUPI dashboard ("Zap Key")
ZAPUPI_KEY=

# Full webhook URL — must match the deployed backend URL
ZAPUPI_WEBHOOK_URL=https://pgrbattle-backend.onrender.com/api/deposit/zapupi-webhook

# Optional: ZapUPI server gateway IP for webhook origin validation
# ZAPUPI_GATEWAY_IP=72.61.225.127

# ==================================================
# NOTIFICATION ENGINE
# ==================================================
NOTIFICATION_TIMEZONE=Asia/Kolkata
NOTIFICATION_UTC_OFFSET=+05:30

# ==================================================
# ORGANIZER ECONOMY (optional - safe to leave unset)
# ==================================================
# How far back the deadline penalty sweep looks for missed starts, in hours (max 720).
# Unset means 48. Charging stays off until an admin enables it in the Admin app, so
# nothing here moves coins on its own.
# ORGANIZER_PENALTY_LOOKBACK_HOURS=48

# The day boundary used for an organizer's daily tournament allowance. Leave unset to
# follow NOTIFICATION_UTC_OFFSET above, so "today" means the same local day on both
# features. Format: +05:30, -0800, or a number of minutes.
# ORGANIZER_DAILY_LIMIT_UTC_OFFSET=+05:30
